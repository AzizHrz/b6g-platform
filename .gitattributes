# Fins de ligne normalisées (évite les conflits entre Linux, macOS et Windows)
* text=auto eol=lf
*.sh  text eol=lf
*.bat text eol=crlf
# Fichiers binaires
*.png binary
*.jpg binary
*.pdf binary
*.pcapng binary
*.parquet binary
# Fichiers régénérés par un outil : en cas de conflit, régénérer plutôt que fusionner à la main
datasets/samples/*      linguist-generated=true
contracts/examples/**   linguist-generated=true
