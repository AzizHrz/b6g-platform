{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b6g.local/contracts/decision.schema.json",
  "title": "I-05 Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "policy",
    "actions",
    "confidence",
    "explanation",
    "model_version",
    "latency_ms"
  ],
  "properties": {
    "decision_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "policy": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "action-request.schema.json"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "explanation": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    }
  }
}
