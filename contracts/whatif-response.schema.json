{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b6g.local/contracts/whatif-response.schema.json",
  "title": "I-06 WhatIfResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicted",
    "sla_ok",
    "violations",
    "confidence"
  ],
  "properties": {
    "predicted": {
      "type": "object",
      "required": [
        "slices"
      ],
      "properties": {
        "slices": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "embb",
              "v2x",
              "miot"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "latency_ms_p95": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "throughput_mbps": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "loss_ratio": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "sla_ok": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slice",
          "metric",
          "value",
          "limit"
        ],
        "properties": {
          "slice": {
            "enum": [
              "embb",
              "v2x",
              "miot"
            ]
          },
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
