{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b6g.local/contracts/scenario.schema.json",
  "title": "I-01 Scénario partagé",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "plmn",
    "tac",
    "hosts",
    "slices",
    "capacity",
    "ues",
    "profiles",
    "tiers",
    "links",
    "ports"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "plmn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcc",
        "mnc"
      ],
      "properties": {
        "mcc": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "mnc": {
          "type": "string",
          "pattern": "^[0-9]{2,3}$"
        }
      }
    },
    "tac": {
      "type": "integer",
      "minimum": 0
    },
    "hosts": {
      "type": "object",
      "required": [
        "plat",
        "intel"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "slices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sst",
          "sd",
          "dnn",
          "subnet",
          "smf",
          "upf",
          "five_qi",
          "sla",
          "bandwidth"
        ],
        "properties": {
          "id": {
            "enum": [
              "embb",
              "v2x",
              "miot"
            ]
          },
          "sst": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "sd": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{6}$"
          },
          "dnn": {
            "type": "string",
            "minLength": 1
          },
          "subnet": {
            "type": "string",
            "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$"
          },
          "smf": {
            "type": "string"
          },
          "upf": {
            "type": "string"
          },
          "five_qi": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "sla": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "latency_ms_p95_max",
              "throughput_mbps_min",
              "loss_ratio_max"
            ],
            "properties": {
              "latency_ms_p95_max": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "throughput_mbps_min": {
                "type": "number",
                "minimum": 0
              },
              "loss_ratio_max": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "bandwidth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rate_mbps",
              "ceil_mbps"
            ],
            "properties": {
              "rate_mbps": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 1000
              },
              "ceil_mbps": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 1000
              }
            }
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "required": [
        "total_rate_mbps_max"
      ],
      "properties": {
        "total_rate_mbps_max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "ues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count_per_slice",
        "imsi_base",
        "id_pattern"
      ],
      "properties": {
        "count_per_slice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "imsi_base": {
          "type": "string",
          "pattern": "^[0-9]{15}$"
        },
        "id_pattern": {
          "type": "string"
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "slice",
          "proto",
          "direction"
        ],
        "properties": {
          "slice": {
            "enum": [
              "embb",
              "v2x",
              "miot"
            ]
          },
          "proto": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "direction": {
            "enum": [
              "ul",
              "dl"
            ]
          },
          "rate_mbps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "rate_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "fog",
        "cloud"
      ],
      "properties": {
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k8s_node",
            "added_rtt_ms",
            "cpu_millicores",
            "memory_mb"
          ],
          "properties": {
            "k8s_node": {
              "type": "string"
            },
            "added_rtt_ms": {
              "type": "number",
              "minimum": 0
            },
            "cpu_millicores": {
              "type": "integer",
              "minimum": 1
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "fog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k8s_node",
            "added_rtt_ms",
            "cpu_millicores",
            "memory_mb"
          ],
          "properties": {
            "k8s_node": {
              "type": "string"
            },
            "added_rtt_ms": {
              "type": "number",
              "minimum": 0
            },
            "cpu_millicores": {
              "type": "integer",
              "minimum": 1
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "cloud": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k8s_node",
            "added_rtt_ms",
            "cpu_millicores",
            "memory_mb"
          ],
          "properties": {
            "k8s_node": {
              "type": "string"
            },
            "added_rtt_ms": {
              "type": "number",
              "minimum": 0
            },
            "cpu_millicores": {
              "type": "integer",
              "minimum": 1
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "nfs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^b6g-[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/link_id"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "ports": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "required": [
        "prometheus",
        "grafana",
        "actuator",
        "ledger",
        "decision",
        "twin"
      ]
    }
  }
}
